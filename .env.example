# =============================================================================
# IntelliDocs environment configuration
# Copy this file to .env and fill in values. Never commit .env.
# API keys live only on the backend — they are never sent to the browser.
# =============================================================================

# --- LLM ---
# openai  = OpenAI API (https://api.openai.com/v1)
# groq    = Groq OpenAI-compatible API (free tier available)
# mock    = Deterministic local provider (tests / offline demos)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override for any OpenAI-compatible endpoint
OPENAI_BASE_URL=

# --- Embeddings ---
# mock = deterministic local vectors, zero downloads, no key (dev/demo/tests).
#        NOTE: mock embeddings are not truly semantic — swap to `api` for real
#        similarity search.
# api  = any OpenAI-compatible embeddings endpoint (OpenAI, Voyage, etc.)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# Required when EMBEDDING_PROVIDER=api (falls back to OPENAI_API_KEY)
EMBEDDING_API_KEY=
# Optional override; falls back to OPENAI_BASE_URL
EMBEDDING_API_BASE=

# --- Storage ---
# SQLite path is relative to the backend working directory unless absolute.
DATABASE_URL=sqlite:///./data/intellidocs.db
# local = built-in cosine-similarity store (JSON persistence, no extra deps)
# chroma = optional ChromaDB backend (requires `pip install chromadb`)
VECTOR_STORE=local
VECTOR_PATH=./data/vectors
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads


# --- Security ---
# Max upload size in megabytes. Reject larger files before they are stored.
MAX_UPLOAD_MB=15
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Retrieval ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Frontend (used by Next.js only; no secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
